	column 'Reasons for Variance'
		dataType: string
		lineageTag: c4c4017c-ebdc-4d99-84fe-73cbb9ed8d5f
		summarizeBy: none
		sourceColumn: Reasons for Variance

		annotation SummarizationSetBy = Automatic

	partition MasterTable = m
		mode: import
		queryGroup: MasterTables
		source = ```
				let
				    Source = RowData,
				    Custom2 = Table.AddColumn(Source, "Reasons for Variance", each 
				    if Text.Contains([activityHistory], "Outstanding Design") then "Outstanding Design"
				    else if Text.Contains([activityHistory], "Works not instructed") then "Works not instructed"
				    else if Text.Contains([activityHistory], "Equipment Unavailable") then "Equipment Unavailable"
				    else if Text.Contains([activityHistory], "Labour shortfall") then "Labour shortfall"
				    else if Text.Contains([activityHistory], "Predecessor incomplete") then "Predecessor incomplete"
				    else if Text.Contains([activityHistory], "Safety non compliance") then "Safety non compliance"
				    else if Text.Contains([activityHistory], "Safety issues/stand-downs") then "Safety issues/stand-downs"
				    else if Text.Contains([activityHistory], "Quality issue Rework") then "Quality issue Rework"
				    else if Text.Contains([activityHistory], "Quality of installation") then "Quality of installation"
				    else if Text.Contains([activityHistory], "Adverse Weather") then "Adverse Weather"
				    else if Text.Contains([activityHistory], "Weather") then "Weather"
				    else if Text.Contains([activityHistory], "Approvals") then "Approvals"
				    else if Text.Contains([activityHistory], "Operations") then "Operations"
				    else if Text.Contains([activityHistory], "Resquencing of works") then "Resquencing of works"
				    else if Text.Contains([activityHistory], "No access") then "No access"
				    else if Text.Contains([activityHistory], "Partial access") then "Partial access"
				    else if Text.Contains([activityHistory], "Access interrupted") then "Access interrupted"
				    else if Text.Contains([activityHistory], "Late design") then "Late design"
				    else if Text.Contains([activityHistory], "Design change") then "Design change"
				    else if Text.Contains([activityHistory], "Inadequate design") then "Inadequate design"
				    else if Text.Contains([activityHistory], "Awaiting design clarifica") then "Awaiting design clarifica"
				    else if Text.Contains([activityHistory], "Scope variation") then "Scope variation"
				    else if Text.Contains([activityHistory], "On hold' instructions") then "On hold' instructions"
				    else if Text.Contains([activityHistory], "Work by others incomplete") then "Work by others incomplete"
				    else if Text.Contains([activityHistory], "Free issue material") then "Free issue material"
				    else if Text.Contains([activityHistory], "Material") then "Material"
				    else if Text.Contains([activityHistory], "Performance/productivity") then "Performance/productivity"
				    else if Text.Contains([activityHistory], "Client change request") then "Client change request"
				    else if Text.Contains([activityHistory], "Decision to re-sequence") then "Decision to re-sequence"
				    else if Text.Contains([activityHistory], "Contractor Not appointed") then "Contractor Not appointed"
				    else if Text.Contains([activityHistory], "Ahead of Schedule") then "Ahead of Schedule"
				    else if Text.Contains([activityHistory], "Health and Safety") then "Health and Safety"
				    else if Text.Contains([activityHistory], "Under estimation of effort") then "Under estimation of effort"
				    else if Text.Contains([activityHistory], "Others") then "Others"
				    else null),
				    Custom3 = Table.AddColumn(Custom2, "Reasons Category", each if Text.Contains([activityHistory], "started late") then "Late Start" else if Text.Contains([activityHistory], "completed late") then "Late Complete" else if Text.Contains([activityHistory], "Stopped") then "Stopped" else if Text.Contains([activityHistory], "warning by") then "Warning" else if Text.Contains([activityHistory], "rescheduled by") then "rescheduled by" else null),
				     #"Changed Type" = Table.TransformColumnTypes(Custom3,{{"actualStartDate", type datetime},{"actualEndDate", type datetime},{"plannedStartDate", type datetime},{"plannedEndDate", type datetime},{"historyDateTime", type datetime}}),
				    Custom1 = Table.TransformColumnTypes(#"Changed Type",{{"actualStartDate", type date},{"actualEndDate", type date},{"plannedStartDate", type date},{"plannedEndDate", type date}}),
				    #"PlannedWeek-Year" = Table.AddColumn(Custom1, "Planned_Week-Year", each Text.From(Date.Year([plannedEndDate])) & "-" & Text.PadStart( Text.From(  if Number.RoundDown((Date.DayOfYear([plannedEndDate])-(Date.DayOfWeek([plannedEndDate], Day.Monday)+1)+10)/7)=0
				        then Number.RoundDown((Date.DayOfYear(#date(Date.Year([plannedEndDate])-1,12,31))-(Date.DayOfWeek(#date(Date.Year([plannedEndDate])-1,12,31), Day.Monday)+1)+10)/7)
				        else if (Number.RoundDown((Date.DayOfYear([plannedEndDate])-(Date.DayOfWeek([plannedEndDate], Day.Monday)+1)+10)/7)=53 and (Date.DayOfWeek(#date(Date.Year([plannedEndDate]),12,31), Day.Monday)+1<4))
				        then 1 else Number.RoundDown((Date.DayOfYear([plannedEndDate])-(Date.DayOfWeek([plannedEndDate], Day.Monday)+1)+10)/7) ), 2, "0"), type text ),
				    #"ActualWeek-Year" = Table.AddColumn(#"PlannedWeek-Year", "Actual_Week-Year", each Text.From(Date.Year([actualEndDate])) & "-" & Text.PadStart( Text.From(  if Number.RoundDown((Date.DayOfYear([actualEndDate])-(Date.DayOfWeek([actualEndDate], Day.Monday)+1)+10)/7)=0
				        then Number.RoundDown((Date.DayOfYear(#date(Date.Year([actualEndDate])-1,12,31))-(Date.DayOfWeek(#date(Date.Year([actualEndDate])-1,12,31), Day.Monday)+1)+10)/7)
				        else if (Number.RoundDown((Date.DayOfYear([actualEndDate])-(Date.DayOfWeek([actualEndDate], Day.Monday)+1)+10)/7)=53 and (Date.DayOfWeek(#date(Date.Year([actualEndDate]),12,31), Day.Monday)+1<4))
				        then 1 else Number.RoundDown((Date.DayOfYear([actualEndDate])-(Date.DayOfWeek([actualEndDate], Day.Monday)+1)+10)/7) ), 2, "0"), type text ),
				    #"Added Custom" = Table.AddColumn(#"ActualWeek-Year", "Planned_PPC", each if [#"Actual_Week-Year"] <> null then
				            if [#"Actual_Week-Year"] = [#"Planned_Week-Year"] then "Yes" else "No"
				        else
				            "No"),
				    Custom4 = Table.AddColumn(#"Added Custom", "Reasons for Variance1", each if List.Contains({"No access","Access interrupted","Partial access"}, [Reasons for Variance]) then "Space"
				else if List.Contains({"Approvals"}, [Reasons for Variance]) then "Approvals"
				else if List.Contains({"Client change request","Scope variation"}, [Reasons for Variance]) then "Scope Variation"
				else if List.Contains({"Adverse Weather","Weather"}, [Reasons for Variance]) then "Adverse Weather"
				else if List.Contains({"Health and Safety","Safety non compliance","Safety issues/stand-downs"}, [Reasons for Variance]) then "Health and Safety"
				else if List.Contains({"Labour shortfall","Under estimation of effort","Contractor Not appointed","Performance/productivity"}, [Reasons for Variance]) then "Labour Shortfall"
				else if List.Contains({"Material","Free issue material"}, [Reasons for Variance]) then "Materials"
				else if List.Contains({"Ahead of Schedule","Others"}, [Reasons for Variance]) then "Others"
				else if List.Contains({"Outstanding Design","Design change","Inadequate design","Late design","On hold' instructions","Awaiting design clarifica"}, [Reasons for Variance]) then "Design"
				else if List.Contains({"Works not instructed"}, [Reasons for Variance]) then "Works not instructed"
				else if List.Contains({"Operations","Decision to re-sequence"}, [Reasons for Variance]) then "Operations"
				else if List.Contains({"Equipment Unavailable"}, [Reasons for Variance]) then "Equipments"
				else if List.Contains({"Predecessor incomplete","Work by others incomplete"}, [Reasons for Variance]) then "Predecessor incomplete"
				else if List.Contains({"Quality issue Rework","Quality of installation"}, [Reasons for Variance]) then "Quality and Rework"
				else if [Reasons for Variance] = null or [Reasons for Variance] = "" then "Uncategorised"
				else null),
				    #"Renamed Columns" = Table.RenameColumns(Custom4,{{"Reasons for Variance", "Reasons for VarianceOld"}, {"Reasons for Variance1", "Reasons for Variance"}})
				in
				    #"Renamed Columns"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

