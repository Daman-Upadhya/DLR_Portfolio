	column 'Today week & Year' = YEAR(TODAY()) & "-" & FORMAT(WEEKNUM(TODAY(),2),"00")
		lineageTag: 0447b3b7-2c06-4796-90d3-324d72e90615
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column LastWeekStart = ```
			
			    VAR TodayDate = TODAY()
			    VAR WeekDayNumber = WEEKDAY(TodayDate, 2) -- 2 indicates that the week starts on Monday
			    VAR LastMonday = TodayDate - WeekDayNumber - 6 -- Calculate the last Monday
			    RETURN LastMonday
			
			//LastWeekEnd = 
			    //VAR TodayDate = TODAY()
			    //VAR WeekDayNumber = WEEKDAY(TodayDate, 2) -- 2 indicates that the week starts on Monday
			    //VAR LastSunday = TodayDate - WeekDayNumber
			    //RETURN LastSunday
			
