	column IsLastSixWeeks = ```
			
			VAR CurrentDate = TODAY()
			VAR StartOfThisWeek = CurrentDate - WEEKDAY(CurrentDate, 2) + 1
			VAR StartOfSixWeeksAgo = StartOfThisWeek - (7 * 6)
			VAR EndOfLastWeek = StartOfThisWeek - 1
			RETURN
			IF(
			    [plannedEndDate] >= StartOfSixWeeksAgo && [plannedEndDate] <= EndOfLastWeek,
			    "Yes",
			    "No"
			)
			
			```
		lineageTag: 37a29a12-9bb0-4c0d-a9ca-2589ff177e94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

