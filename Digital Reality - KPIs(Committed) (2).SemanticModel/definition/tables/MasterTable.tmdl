	column 'Standard Reason' =
			
			SWITCH(
			    TRUE(),
			   [Reasons for VarianceOld] IN {
			        "Awaiting design clarification", "Design change", "Inadequate design",
			        "Late design", "Outstanding Design", "Works not instructed", "On hold' instructions"
			    }, "Outstanding Design",
			
			   [Reasons for VarianceOld] IN {
			        "Material", "Free issue material"
			    }, "Materials",
			
			   [Reasons for VarianceOld] IN {
			        "Labour shortfall", "Contractor Not appointed",
			        "Performance/productivity", "Under estimation of effort"
			    }, "Labour / Resources",
			
			   [Reasons for VarianceOld] IN {
			        "Equipment Unavailable"
			    }, "Plant & Equipment",
			
			   [Reasons for VarianceOld] IN {
			        "No access", "Access interrupted", "Partial access"
			    }, "Access / Space",
			
			   [Reasons for VarianceOld] IN {
			        "Predecessor incomplete", "Work by others incomplete"
			    }, "Predecessor Work",
			
			   [Reasons for VarianceOld] IN {
			        "Approvals", "Client change request", "Scope variation"
			    }, "Client / Approvals",
			
			   [Reasons for VarianceOld] IN {
			        "Quality issue Rework", "Quality of installation"
			    }, "Quality & Rework",
			
			   [Reasons for VarianceOld] IN {
			        "Health and Safety", "Safety issues/stand-downs", "Safety non compliance"
			    }, "Health & Safety",
			
			   [Reasons for VarianceOld] IN {
			        "Adverse Weather", "Weather"
			    }, "External / Weather",
			
			   [Reasons for VarianceOld] IN {
			        "Decision to re-sequence", "Operations"
			    }, "Planning / Sequencing",
			
			   [Reasons for VarianceOld] IN {
			        "Others", "Ahead of Schedule"
			    }, "Other",
			
			    "Uncategorised"
			)
		lineageTag: 820fa829-4f1a-4cf2-91d2-0360100e6d48
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

