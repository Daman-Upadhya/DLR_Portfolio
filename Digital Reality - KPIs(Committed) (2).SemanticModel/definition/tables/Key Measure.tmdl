	measure Successful_Constraints =
			
			VAR _LinkedConstraints = CALCULATE(
			                             DISTINCTCOUNT(AllConstraintsLog[UniqueID]),
			                                AllConstraintsLog[activityGuid]<>BLANK(),
			                                AllConstraintsLog[completionDate]<=AllConstraintsLog[plannedStartDate],
			                                NOT ISBLANK(AllConstraintsLog[completionDate]))
			
			RETURN
			_LinkedConstraints
		formatString: 0
		lineageTag: f3f5d388-1cdb-457b-a02d-43abcb717f90

	measure '%ConstraintsResolved Before PL Start' =
			
			VAR LinkedTasks = CALCULATE([Total_Constraints],AllConstraintsLog[activityGuid]<>BLANK())
			
			RETURN
			DIVIDE([Successful_Constraints],LinkedTasks,0)+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6d55d91a-778c-4805-9b74-3fd3aafd5f28

	measure Successful(BeforeTarget) =
			
			VAR _Closed =  CALCULATE(DISTINCTCOUNT ( AllConstraintsLog[UniqueID] ),
			                          AND ( AllConstraintsLog[completionDate]<>BLANK(),
			                              AllConstraintsLog[completionDate]<=AllConstraintsLog[targetDate]
			                              )
			                        )
			VAR _Total = CALCULATE(DISTINCTCOUNT(AllConstraintsLog[UniqueID]))
			RETURN
			_Closed
		formatString: 0
		lineageTag: 55880fcb-2a43-44f4-9dce-19a3c8dab8b8

	measure Unsuccessful(Target) = [Total_Constraints] - [Successful(BeforeTarget)]
		formatString: 0
		lineageTag: 97c5f5ec-aae4-4601-96cb-90e78726bf56

	measure !!PPC(Committed) =
			
			var _t  = CALCULATE(DISTINCTCOUNT(All_Committed_Task[activitiesGuid]),All_Committed_Task[Custom_CommittedPPC]=="Yes",'Calendar'[IsLastSixWeeks]="Yes")
			var _s = CALCULATE(DISTINCTCOUNT(All_Committed_Task[activitiesGuid]),'Calendar'[IsLastSixWeeks]="Yes")
			var _d  = DIVIDE(_t,_s)
			RETURN
			IF(_d ==BLANK(),0,_d)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb2d5a33-e1d3-46af-b7b9-8f82edbc24da

	measure '!!@Remaining Score' = 100 - [!!@Total Score]
		lineageTag: b4d63d04-3d86-4b82-8cc2-8401e80e889b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '!!PPC Avg (6wk Running)' =
			
			CALCULATE(
			    AVERAGEX(
			        VALUES('Calendar'[Week & Year]),
			        VAR _t = CALCULATE(
			            DISTINCTCOUNT(All_Committed_Task[activitiesGuid]),
			            All_Committed_Task[Custom_CommittedPPC] = "Yes"
			        )
			        VAR _s = CALCULATE(DISTINCTCOUNT(All_Committed_Task[activitiesGuid]))
			        VAR _d = DIVIDE(_t, _s)
			        RETURN IF(_d = BLANK(), 0, _d)
			    ),
			    'Calendar'[IsLastSixWeeks] = "Yes"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f916595f-780a-44b3-adcd-e05c3589f192

	measure '!!@Total Score1' =
			
			VAR _PPC         = CALCULATE([!!PPC Avg (6wk Running)], 'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _ActDelayed  = CALCULATE([!!%Activity_Delayed],   'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _ConstrOver  = CALCULATE([!!%Constraints_Overdue],'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _AvgDelay    = CALCULATE([!!Avg_Delay_Durations], 'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _PlannedDur  = CALCULATE([!!Avg_Planned_Duration],'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _WeeklyPlan  = CALCULATE([!!Avg_Activity_Week],   'Calendar'[IsLastSixWeeks] = "Yes")
			
			VAR PPCScore =
			    SWITCH(TRUE(),
			        _PPC >= 0.85, 100,
			        _PPC >= 0.75, 80,
			        _PPC >= 0.65, 60,
			        _PPC >= 0.55, 40,
			        20)
			
			VAR ActivityDelayedScore =
			    SWITCH(TRUE(),
			        _ActDelayed <= 0.05, 100,
			        _ActDelayed <= 0.10, 80,
			        _ActDelayed <= 0.20, 60,
			        _ActDelayed <= 0.30, 40,
			        20)
			
			VAR ConstraintsOverdueScore =
			    SWITCH(TRUE(),
			        _ConstrOver <= 0.05, 100,
			        _ConstrOver <= 0.10, 80,
			        _ConstrOver <= 0.20, 60,
			        _ConstrOver <= 0.30, 40,
			        20)
			
			VAR AvgDelayScore =
			    SWITCH(TRUE(),
			        _AvgDelay <= 3,  100,
			        _AvgDelay <= 7,  80,
			        _AvgDelay <= 14, 60,
			        _AvgDelay <= 30, 40,
			        20)
			
			VAR PlannedDurationScore =
			    SWITCH(TRUE(),
			        _PlannedDur <= 6,  100,
			        _PlannedDur <= 8,  80,
			        _PlannedDur <= 10, 60,
			        _PlannedDur <= 12, 40,
			        20)
			
			VAR WeeklyPlannedScore =
			    SWITCH(TRUE(),
			        _WeeklyPlan > 70,  100,
			        _WeeklyPlan >= 61, 80,
			        _WeeklyPlan >= 41, 60,
			        _WeeklyPlan >= 30, 40,
			        20)
			
			RETURN
			    PPCScore            * 0.35
			    + ActivityDelayedScore  * 0.15
			    + ConstraintsOverdueScore * 0.15
			    + AvgDelayScore         * 0.15
			    + PlannedDurationScore  * 0.1
			    + WeeklyPlannedScore    * 0.1
		formatString: 0
		lineageTag: baa5eab2-37cc-4456-9266-46879f18e67c

