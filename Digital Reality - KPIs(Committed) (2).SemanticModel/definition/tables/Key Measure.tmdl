table 'Key Measure'
	lineageTag: e0275d49-f7d6-40e4-8d57-be1ba459a9c8

	measure !!PPC =
			
			var _t  = CALCULATE(DISTINCTCOUNT('MasterTable'[guid]),'MasterTable'[Planned_PPC]=="Yes",'Calendar'[IsLastSixWeeks]="Yes")
			var _s = CALCULATE(DISTINCTCOUNT('MasterTable'[guid]),'Calendar'[IsLastSixWeeks]="Yes")
			var _d  = DIVIDE(_t,_s)
			RETURN
			IF(_d ==BLANK(),0,_d)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b837ada6-95bc-4fdc-abe2-c3742c290473

	measure Remaining = 1-[!!PPC]
		lineageTag: 5376d5be-c744-4a86-8625-7ddd9f6355ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Task' = CALCULATE(DISTINCTCOUNT('MasterTable'[guid]))+0
		formatString: 0
		lineageTag: 2725d351-2cfc-4678-93e5-535b04608ab2

	measure 'Successful Task' = CALCULATE(DISTINCTCOUNT('MasterTable'[guid]),'MasterTable'[Planned_PPC]=="Yes")+0
		formatString: 0
		lineageTag: bb27de90-7f72-4b51-b380-b58e13d01709

	measure 'UnSuccessful Constraints' =
			
			VAR _LinkedConstraints = CALCULATE(
			                             DISTINCTCOUNT(AllConstraintsLog[UniqueID]),
			                                AllConstraintsLog[activityGuid]<>BLANK(),
			                                AllConstraintsLog[targetDate]<TODAY(),
			                                AllConstraintsLog[completionDate]>AllConstraintsLog[plannedStartDate] ||
			                                ISBLANK(AllConstraintsLog[completionDate]))
			RETURN
			_LinkedConstraints
		formatString: 0
		lineageTag: 0988da61-ff7c-46aa-b05c-dbdd86d75124

	measure 'Delay Task' = CALCULATE(DISTINCTCOUNT('MasterTable'[guid]),'MasterTable'[Delay]=="Delay")+0
		formatString: 0
		lineageTag: 0eac9f6d-99c7-4c19-b230-f08c53f6650b

	measure 'Open Constraints' = IF(CALCULATE(DISTINCTCOUNT('AllConstraintsLog'[UniqueID]),'AllConstraintsLog'[completionDate]==BLANK())==BLANK(),0,CALCULATE(DISTINCTCOUNT('AllConstraintsLog'[UniqueID]),'AllConstraintsLog'[completionDate]==BLANK()))
		formatString: 0
		lineageTag: 8e993bef-85e2-4020-a78a-bb3ed5130958

	measure min% = .85
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 70a89440-30cb-42d2-993a-382fe03be0fd

	measure 'Measure 3' = CALCULATE(DISTINCTCOUNT(MasterTable[guid]),MasterTable[Reasons Category]="rescheduled by")
		formatString: 0
		lineageTag: 3492bf45-2a5d-4dd2-a494-c7019fdfcf61

	measure !!ConstraintsResolvedonTIme =
			
			VAR _Closed =  CALCULATE(DISTINCTCOUNT ( AllConstraintsLog[UniqueID] ),
			                          AND ( AllConstraintsLog[completionDate]<>BLANK(),
			                              AllConstraintsLog[completionDate]<=AllConstraintsLog[targetDate]
			                              )
			                        )
			VAR _Total = CALCULATE(DISTINCTCOUNT(AllConstraintsLog[UniqueID]))
			RETURN
			CALCULATE(DIVIDE(_Closed,_Total,0),'Calendar'[IsLastSixWeeks]="Yes")+0
		formatString: 0%;-0%;0%
		lineageTag: 63234231-1e27-483b-bafc-858375fbaeff

	measure !!Avg_Activity_Week = ```
			
			CALCULATE(
			AVERAGEX (
			    VALUES ( MasterTable[Planned_Week-Year] ),
			    CALCULATE ( DISTINCTCOUNT(MasterTable[guid]) )
			)+0,MasterTable[IsLastSixWeeks]="Yes")
			
			```
		formatString: 0
		lineageTag: 256ace40-84a1-4eeb-a006-912bbec3e33e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Avg._Lagtime' =
			
			ROUNDUP (
			    AVERAGEX (
			        SUMMARIZE (
			            AllConstraintsLog,
			            AllConstraintsLog[UniqueID],
			            "LagPerConstraint", MAX ( AllConstraintsLog[LagTime] )
			        ),
			        [LagPerConstraint]
			    ),
			    0
			)
			+0
		formatString: 0
		lineageTag: 2bb073b4-b530-4b72-b3b8-01bda42543fe

		annotation PBI_FormatHint = {"isDecimal":true}

	measure !!%Constraints_Overdue =
			
			Var _t = CALCULATE(COUNT(AllConstraintsLog[UniqueID]),AllConstraintsLog[targetDate]<=TODAY(),AllConstraintsLog[completionDate]==BLANK())
			Var _tt = CALCULATE(COUNT(AllConstraintsLog[UniqueID]))
			
			RETURN
			CALCULATE(DIVIDE(_t,_tt,0),'Calendar'[IsLastSixWeeks]="Yes")+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1403ec84-79d5-4874-9d37-62948f3b3432

	measure Unlinked(%) =
			
			VAR _t = CALCULATE(COUNT(AllConstraintsLog[UniqueID]),AllConstraintsLog[activityGuid]=BLANK())
			VAR _tt = CALCULATE(COUNT(AllConstraintsLog[UniqueID]))
			RETURN
			_t/_tt
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 66d207d4-f225-45af-a7b1-e240ee17295a

	measure !!%Activity_Delayed =
			
			Var _t = CALCULATE(DISTINCTCOUNT(MasterTable[guid]),
			                                 OR(
			                                    AND(MasterTable[plannedStartDate]<=TODAY(),MasterTable[actualStartDate]==BLANK()),
			                                    AND(MasterTable[plannedEndDate]<=TODAY(),MasterTable[actualEndDate]==BLANK())))
			
			Var _tt = CALCULATE(DISTINCTCOUNT(MasterTable[guid]),OR(MasterTable[plannedStartDate]<=TODAY(),MasterTable[plannedEndDate]<=TODAY()))
			RETURN
			CALCULATE(DIVIDE(_t,_tt,0),'Calendar'[IsLastSixWeeks]="Yes")+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d23e8cf1-a111-4ccb-aa04-f3640fe5afa9

	measure !!Avg_Delay_Durations =
			CALCULATE(
			ROUNDUP (
			    AVERAGEX (
			        SUMMARIZE (
			            MasterTable,
			            MasterTable[guid],
			            "LagPerdelay", MAX ( MasterTable[DelayDays] )
			        ),
			        [LagPerdelay]
			    ),
			    0
			),'Calendar'[IsLastSixWeeks]="Yes")
			+0
		lineageTag: 303e7e7c-dd3d-461d-9f20-0f2f7dcc5b68

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Constraints = CALCULATE(DISTINCTCOUNT(AllConstraintsLog[UniqueID]),AllConstraintsLog[category]<>BLANK())
		formatString: 0
		lineageTag: df6255e1-5a4d-408f-863c-509473fb7bdf

	measure !!Avg_Planned_Duration = ```
			CALCULATE(
			AVERAGEX (
			    DISTINCT (MasterTable[guid] ),
			    CALCULATE ( MAX(MasterTable[plannedDuration] ))),'Calendar'[IsLastSixWeeks]="Yes"
			)
			
			```
		formatString: 0
		lineageTag: 58c9d9a8-33c7-4b44-8782-e731a8e208bf

		annotation PBI_FormatHint = {"isDecimal":true}

	measure ProjectName = SELECTEDVALUE(ProjectList[ProjectList]) & " - Planned PPC Overview"
		lineageTag: 612b21c8-7f78-404b-9ecd-0b486f140420

	measure ReasonsCounts = CALCULATE(DISTINCTCOUNT(MasterTable[guid]))
		formatString: 0
		lineageTag: 1f08ef71-c70d-43a2-9201-224ffbca4b2d

	measure Constraint_guid = CALCULATE(DISTINCTCOUNT(AllConstraintsLog[UniqueID]))
		formatString: 0
		lineageTag: 9375d6ae-9b7a-4655-b718-cf31373fa652

	measure '!!@Total Score' =
			
			VAR _PPC         = CALCULATE([!!PPC Avg (6wk Running)], 'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _ActDelayed  = CALCULATE([!!%Activity_Delayed],   'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _ConstrOver  = CALCULATE([!!%Constraints_Overdue],'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _AvgDelay    = CALCULATE([!!Avg_Delay_Durations], 'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _PlannedDur  = CALCULATE([!!Avg_Planned_Duration],'Calendar'[IsLastSixWeeks] = "Yes")
			VAR _WeeklyPlan  = CALCULATE([!!Avg_Activity_Week],   'Calendar'[IsLastSixWeeks] = "Yes")
			
			VAR PPCScore =
			    SWITCH(TRUE(),
			        _PPC >= 0.85, 100,
			        _PPC >= 0.75, 80,
			        _PPC >= 0.65, 60,
			        _PPC >= 0.55, 40,
			        20)
			
			VAR ActivityDelayedScore =
			    SWITCH(TRUE(),
			        _ActDelayed <= 0.05, 100,
			        _ActDelayed <= 0.10, 80,
			        _ActDelayed <= 0.20, 60,
			        _ActDelayed <= 0.30, 40,
			        20)
			
			VAR ConstraintsOverdueScore =
			    SWITCH(TRUE(),
			        _ConstrOver <= 0.05, 100,
			        _ConstrOver <= 0.10, 80,
			        _ConstrOver <= 0.20, 60,
			        _ConstrOver <= 0.30, 40,
			        20)
			
			VAR AvgDelayScore =
			    SWITCH(TRUE(),
			        _AvgDelay <= 3,  100,
			        _AvgDelay <= 7,  80,
			        _AvgDelay <= 14, 60,
			        _AvgDelay <= 30, 40,
			        20)
			
			VAR PlannedDurationScore =
			    SWITCH(TRUE(),
			        _PlannedDur <= 6,  100,
			        _PlannedDur <= 8,  80,
			        _PlannedDur <= 10, 60,
			        _PlannedDur <= 12, 40,
			        20)
			
			VAR WeeklyPlannedScore =
			    SWITCH(TRUE(),
			        _WeeklyPlan > 70,  100,
			        _WeeklyPlan >= 61, 80,
			        _WeeklyPlan >= 41, 60,
			        _WeeklyPlan >= 30, 40,
			        20)
			
			RETURN
			    PPCScore            * 0.35
			    + ActivityDelayedScore  * 0.15
			    + ConstraintsOverdueScore * 0.15
			    + AvgDelayScore         * 0.15
			    + PlannedDurationScore  * 0.1
			    + WeeklyPlannedScore    * 0.1
		formatString: 0
		lineageTag: ffd30af5-d530-47b3-95c2-4e67e94a3aae

	measure !!@TotalScore_Status =
			IF([!!@Total Score]>=75,"Green",
			                              IF( [!!@Total Score]>=50,"Amber","Red"))
		lineageTag: e41e577f-f123-4d86-87dc-592cca532721

	measure !!TotalProjects = "Total Projects : " & DISTINCTCOUNT(ProjectList[ProjectList])
