	column 'Delayed Constraint' = IF(AND('AllConstraintsLog'[targetDate]<TODAY(),'AllConstraintsLog'[Constraints Status]<>"closed"),"Delay",BLANK())
		lineageTag: 4bb7c3e1-9674-4469-905b-ee2f4aa06f51
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column #CreationYrWeek =
			
			var _t = YEAR([creationDate]) & "-" & FORMAT(WEEKNUM([creationDate],2),"00")
			RETURN
			if(_t == "2024-53","2025-01",_t)
		lineageTag: f88e35dc-5858-46fb-8635-7445e1a11563
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column #TargetYrWeek =
			
