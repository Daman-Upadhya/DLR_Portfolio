	column 'Delayed by days Constraint' = IF(AND('AllConstraintsLog'[targetDate]<TODAY(),'AllConstraintsLog'[Constraints Status]<>"closed"),DATEDIFF('AllConstraintsLog'[targetDate],TODAY(),DAY),BLANK())
