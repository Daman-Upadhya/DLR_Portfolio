	partition AllConstraintsLog = m
		mode: import
		queryGroup: MasterTables
		source = ```
				let
				    Source = Table.Combine({DPFCampus_Constraints, Mercury_Constraints,ExceptDPFCampus_Cons}),
				    #"Changed Type1" = Table.TransformColumnTypes(Source,{{"targetDate", type date}, {"creationDate", type date}, {"commitmentDate", type date}, {"completionDate", type date}}),
				    Custom1 = Table.AddColumn(#"Changed Type1", "Constraints Status", each if [commitmentDate] = null then "Open" else if [completionDate] = null then "Committed" else "Closed"),
				    #"Split Column by Delimiter" = Table.ExpandListColumn(Table.TransformColumns(Custom1, {{"activityGuid", Splitter.SplitTextByDelimiter(",", QuoteStyle.Csv), let itemType = (type nullable text) meta [Serialized.Text = true] in type {itemType}}}), "activityGuid"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"activityGuid", type text}}),
				    Custom2 = let
				    Source = #"Changed Type",
				    Replacements = {
				        {"Materials", "Material"},
				        {"Approvals", "Approval"},
				        {"Others", "Other"},
				        {"External Conditions", "External"},		
				        {"Pre Work Not Complete", "Predecessor"},
				        {"1. Delayed / improper materials", "Material"},		
				        {"2. Preceding work not completed", "Predecessor"},				
				        {"Predecessors", "Predecessor"},
				        {"4. Change of priorities", "Predecessor"},		
				        {"8. Missing / incomplete information", "External"},
				        {"5. Labour shortage", "Manpower"},
				        {"9. Missing tools or machinery", "Equipment"},
				         {"Perdecessor", "Predecessor"},
				        {"Health and Safety", "Safety"}
				    },
				    ReplaceWords = Table.TransformColumns(
				        Source,
				        {{"category", each List.Accumulate(Replacements, _, (state, current) => Text.Replace(state as text, current{0}, current{1})), type text}}
				    )
				in
				    ReplaceWords,
				    Custom3 = Table.ReplaceValue(Custom2,each [Sub Project],each if [Sub Project] = null  then [Custom] else [Sub Project],Replacer.ReplaceValue,{"Sub Project"}),
				    #"Added Custom" = Table.AddColumn(Custom3, "UniqueID", each Text.From([constrainId]) & "_" & 
				    Text.From([Custom]) & "_" & 
				    Text.From([#"Sub Project"]))
				in
				    #"Added Custom"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

